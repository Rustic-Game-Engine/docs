{
  "name": "rustic-engine-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:api-reference": "node --test tests/api-reference.test.mjs",
    "check:api-examples": "node scripts/check-api-examples.mjs",
    "test": "tsx --test tests/*.test.mjs tests/*.test.tsx",
    "test:browser": "playwright test",
    "check:docs": "node scripts/check-docs.mjs && tsx scripts/check-docs.mts",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:engine-drift": "node scripts/check-engine-drift.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:engine-source": "node scripts/check-engine-source.mjs",
    "test:sdk-lifecycle": "node scripts/check-sdk-lifecycle.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.544.0",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1"
  }
}
